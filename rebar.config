{erl_opts, [debug_info, warn_unused_vars, warn_shadow_vars, warn_export_all]}.
{deps, [
  {cowboy, "2.12.0"},
  {jsx, "3.1.0"},
  {epgsql, "4.8.0"}
]}.
{shell, [{apps, [plainwire_relay]}]}.
{relx, [
  {release, {plainwire_relay, "1.1.0"}, [plainwire_relay, sasl]},
  {dev_mode, false},
  {include_erts, true},
  {extended_start_script, true}
]}.
