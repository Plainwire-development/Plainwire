{erl_opts, [debug_info, warn_unused_vars, warn_shadow_vars, warn_export_all]}.
{deps, [
  %% Exact upstream release commits keep builds reproducible and remain compatible
  %% with older Guix rebar3 installations that struggled with Hex metadata.
  %% Cowboy 2.19.0 and Gun 2.6.0 both require Cowlib 2.20.0; Cowboy's
  %% tested Ranch line remains 1.8.1.
  {cowboy, {git, "https://github.com/ninenines/cowboy.git", {ref, "79e3fb02b31d47af6e69e8f3ba18fba291a3072a"}}},
  {cowlib, {git, "https://github.com/ninenines/cowlib.git", {ref, "c768a804565ff5b8178ed968a5921e469d6bd7b2"}}},
  {ranch, {git, "https://github.com/ninenines/ranch.git", {ref, "10b51304b26062e0dbfd5e74824324e9a911e269"}}},
  {gun, {git, "https://github.com/ninenines/gun.git", {ref, "9d40b0ff2de1546e5c613205c4f25aaefffc2569"}}},
  {jsx, "3.1.0"},
  {epgsql, "4.8.0"},
  {erlcass, {git, "https://github.com/silviucpp/erlcass.git", {ref, "a3f752e1a9de007b806f160a6798fb1945dc075b"}}}
]}.
{shell, [{apps, [plainwire_relay]}]}.
{relx, [
  {release, {plainwire_relay, "2.0.0"}, [plainwire_relay, sasl, {erlcass, load}]},
  {dev_mode, false},
  {include_erts, true},
  {extended_start_script, true}
]}.

%% Optional build only. Default deployments do not download or start Partisan.
{profiles, [{cluster, [
  {deps, [{partisan, {git, "https://github.com/lasp-lang/partisan.git", {ref, "45474ceb710dafa91a4af2dc87b34512354f6ba8"}}}]},
  {relx, [{release, {plainwire_relay, "2.0.0"}, [plainwire_relay, sasl, {erlcass, load}, {partisan, load}]}]}
]}]}.
