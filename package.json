{
  "name": "plainwire-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:rich-text && npm run build:haml && npm run build:css && npm run build:elm",
    "build:haml": "bash scripts/build-haml.sh",
    "build:css": "node scripts/build-css.mjs",
    "build:elm": "bash scripts/build-elm.sh",
    "dev": "npm run build:haml && npm run build:css && bash scripts/build-elm.sh",
    "start": "bash scripts/start.sh",
    "start:build": "bash scripts/start.sh --build",
    "test:browser": "node test/browser/run.mjs",
    "test:rtc": "node test/browser/rtc.mjs",
    "test:rtc-contract": "node test/browser/rtc-contract.mjs",
    "test:ui-contract": "node test/browser/ui-contract.mjs",
    "test:admin-contract": "node test/browser/admin-contract.mjs",
    "build:rich-text": "node scripts/build-rich-text.mjs",
    "test:health": "node test/browser/call-health.mjs",
    "test:release-contract": "node test/browser/release-contract.mjs",
    "test:integrations-contract": "node test/browser/integrations-contract.mjs",
    "test:storage-contract": "node test/browser/storage-contract.mjs",
    "test:storage-tools": "node test/browser/storage-tools.mjs",
    "test:v21-contract": "node test/browser/v21-contract.mjs",
    "test:v21-app-contract": "node test/browser/v21-app-contract.mjs",
    "test:v22-bot-contract": "node test/browser/v22-bot-contract.mjs",
    "test:scalability-contract": "node test/browser/scalability-contract.mjs"
  },
  "devDependencies": {
    "elm": "0.19.1-6",
    "esbuild": "0.28.2",
    "less": "4.9.1",
    "playwright": "1.62.1",
    "sass": "1.101.0"
  },
  "dependencies": {
    "haml": "0.4.3",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "elm@0.19.1-6": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
