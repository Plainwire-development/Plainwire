# public production deployment
PLAINWIRE_ENV=production
PLAINWIRE_PUBLIC_URL=https://chat.example.com
COOKIE_SECURE=true
PLAINWIRE_TRUST_PROXY=true

PLAINWIRE_DB_HOST=database.internal
PLAINWIRE_DB_PORT=5432
PLAINWIRE_DB_USER=plainwire
PLAINWIRE_DB_PASS=replace-with-a-strong-password
PLAINWIRE_DB_NAME=plainwire
PLAINWIRE_DB_SSL=true
# start near 2x CPU cores, then watch postgres and tune it
PLAINWIRE_DB_POOL_SIZE=20
PLAINWIRE_DB_MAX_QUEUE=250
PLAINWIRE_DB_STATEMENT_TIMEOUT_MS=15000
PLAINWIRE_DB_SLOW_MS=250

# generate with: openssl rand -base64 32
PLAINWIRE_ENC_KEY=replace-with-a-base64-encoded-32-byte-key
PLAINWIRE_PBKDF2_ITERS=160000

# trusted image/CDN hosts only. keep egress filtering too
PLAINWIRE_MEDIA_ALLOWED_HOSTS=cdn.example.com
PLAINWIRE_MEDIA_FETCH_CONCURRENCY=24

# streamed attachments need durable storage and a 250 MB proxy limit on /api/uploads
PLAINWIRE_UPLOAD_DIR=/var/lib/plainwire/uploads
PLAINWIRE_UPLOAD_MAX_BYTES=262144000
PLAINWIRE_UPLOAD_QUOTA_BYTES=1073741824
PLAINWIRE_UPLOAD_RETENTION_DAYS=90
PLAINWIRE_UPLOAD_CONCURRENCY=64
PLAINWIRE_UPLOAD_USER_CONCURRENCY=4
# big uploads add up. put a ceiling on the pile.
PLAINWIRE_UPLOAD_INFLIGHT_BYTES=1073741824
PLAINWIRE_UPLOAD_USER_INFLIGHT_BYTES=536870912

# cowboy/ranch capacity; proxy and file-descriptor limits need to agree
PLAINWIRE_HTTP_ACCEPTORS=100
PLAINWIRE_HTTP_MAX_CONNECTIONS=100000
PLAINWIRE_HTTP_IDLE_TIMEOUT_MS=60000
PLAINWIRE_HTTP_REQUEST_TIMEOUT_MS=30000
PLAINWIRE_HTTP_MAX_KEEPALIVE=1000

# slow clients do not get to fill the BEAM mailbox forever
PLAINWIRE_WS_SOFT_QUEUE=500
PLAINWIRE_WS_HARD_QUEUE=2000

# example release flags. load-test before turning the knobs to eleven
ERL_FLAGS=+S auto +A 64 +P 2000000 +sbwt very_short +sbwtdcpu very_short +sbwtdio short

# coturn: use-auth-secret, the same static-auth-secret, and a realm
PLAINWIRE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PLAINWIRE_TURN_SECRET=replace-with-at-least-32-random-bytes
PLAINWIRE_TURN_USERNAME=plainwire
PLAINWIRE_TURN_TTL_SECONDS=3600
PLAINWIRE_REQUIRE_TURN=true
PLAINWIRE_RTC_RECONNECT_GRACE_MS=15000

# optional, licensed Krisp bits live in priv/static/krisp (see its README)
PLAINWIRE_KRISP_ENABLED=false
