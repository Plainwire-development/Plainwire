# Public production deployment
PLAINWIRE_ENV=production
PLAINWIRE_PUBLIC_URL=https://chat.example.com
COOKIE_SECURE=true
PLAINWIRE_TRUST_PROXY=true

PLAINWIRE_DB_HOST=database.internal
PLAINWIRE_DB_PORT=5432
PLAINWIRE_DB_USER=plainwire
PLAINWIRE_DB_PASS=replace-with-a-strong-password
PLAINWIRE_DB_NAME=plainwire
PLAINWIRE_DB_SSL=true

# Generate with: openssl rand -base64 32
PLAINWIRE_ENC_KEY=replace-with-a-base64-encoded-32-byte-key
PLAINWIRE_PBKDF2_ITERS=160000

# Keep this list to trusted image/CDN hosts. Network egress filtering is still required.
PLAINWIRE_MEDIA_ALLOWED_HOSTS=cdn.example.com

# Coturn: use-auth-secret, static-auth-secret=<same value>, and a configured realm.
PLAINWIRE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PLAINWIRE_TURN_SECRET=replace-with-at-least-32-random-bytes
PLAINWIRE_TURN_USERNAME=plainwire
PLAINWIRE_TURN_TTL_SECONDS=3600
PLAINWIRE_REQUIRE_TURN=true
