# public production deployment
PLAINWIRE_ENV=production
PLAINWIRE_PUBLIC_URL=https://chat.example.com
COOKIE_SECURE=true
PLAINWIRE_TRUST_PROXY=true

# public client behavior. these values are served at runtime, so one build can
# be reused across deployments without rebuilding the Elm bundle.
PLAINWIRE_APP_NAME=Plainwire
PLAINWIRE_DEFAULT_THEME=system
PLAINWIRE_UPLOAD_MAX_FILES=10
PLAINWIRE_PROFILE_IMAGE_MAX_BYTES=16777216
PLAINWIRE_COMPRESS_OVERSIZE_UPLOADS=true
PLAINWIRE_UPLOAD_IMAGE_MAX_DIMENSION=4096
PLAINWIRE_IDLE_TIMEOUT_MS=600000
PLAINWIRE_SESSION_DAYS=30
PLAINWIRE_MAX_SESSIONS_PER_USER=32

PLAINWIRE_DB_HOST=database.internal
PLAINWIRE_DB_PORT=5432
PLAINWIRE_DB_USER=plainwire
PLAINWIRE_DB_PASS=replace-with-a-strong-password
PLAINWIRE_DB_NAME=plainwire
PLAINWIRE_DB_SSL=true
# start near 2x CPU cores, then watch postgres and tune it
PLAINWIRE_DB_POOL_SIZE=20
PLAINWIRE_DB_MAX_QUEUE=250
PLAINWIRE_DB_STATEMENT_TIMEOUT_MS=15000
PLAINWIRE_DB_IDLE_TX_TIMEOUT_MS=15000
PLAINWIRE_DB_LOCK_TIMEOUT_MS=5000
PLAINWIRE_DB_SLOW_MS=250

# generate with: openssl rand -base64 32
PLAINWIRE_ENC_KEY=replace-with-a-base64-encoded-32-byte-key
PLAINWIRE_PBKDF2_ITERS=160000

# trusted image/CDN hosts only. keep egress filtering too
PLAINWIRE_MEDIA_ALLOWED_HOSTS=cdn.example.com
PLAINWIRE_MEDIA_FETCH_CONCURRENCY=24

# streamed attachments need durable storage and a 250 MB proxy limit on /api/uploads
PLAINWIRE_UPLOAD_DIR=/var/lib/plainwire/uploads
PLAINWIRE_UPLOAD_MAX_BYTES=262144000
PLAINWIRE_UPLOAD_QUOTA_BYTES=1073741824
PLAINWIRE_UPLOAD_RETENTION_DAYS=90
PLAINWIRE_UPLOAD_CONCURRENCY=64
PLAINWIRE_UPLOAD_USER_CONCURRENCY=4
# big uploads add up. put a ceiling on the pile.
PLAINWIRE_UPLOAD_INFLIGHT_BYTES=1073741824
PLAINWIRE_UPLOAD_USER_INFLIGHT_BYTES=536870912

# cowboy/ranch capacity; proxy and file-descriptor limits need to agree
PLAINWIRE_HTTP_ACCEPTORS=100
PLAINWIRE_HTTP_MAX_CONNECTIONS=100000
PLAINWIRE_HTTP_IDLE_TIMEOUT_MS=60000
PLAINWIRE_HTTP_REQUEST_TIMEOUT_MS=30000
PLAINWIRE_HTTP_MAX_KEEPALIVE=1000

# bounded upstream media/embed fetches: slow/dead avatar hosts must not stall UI lists
PLAINWIRE_HTTP_FETCH_TIMEOUT_MS=8000
PLAINWIRE_HTTP_CONNECT_TIMEOUT_MS=2500
# authenticated avatar/file-heavy screens get a generous per-user/IP burst budget
PLAINWIRE_MEDIA_REQUESTS_PER_MINUTE=1200
PLAINWIRE_FILE_REQUESTS_PER_MINUTE=1200

# slow clients do not get to fill the BEAM mailbox forever
PLAINWIRE_WS_SOFT_QUEUE=500
PLAINWIRE_WS_HARD_QUEUE=2000

# example release flags. load-test before turning the knobs to eleven
ERL_FLAGS=+S auto +A 64 +P 2000000 +sbwt very_short +sbwtdcpu very_short +sbwtdio short

# coturn: use-auth-secret, the same static-auth-secret, and a realm
PLAINWIRE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PLAINWIRE_TURN_SECRET=replace-with-at-least-32-random-bytes
PLAINWIRE_TURN_USERNAME=plainwire
PLAINWIRE_TURN_TTL_SECONDS=3600
PLAINWIRE_REQUIRE_TURN=true
PLAINWIRE_RTC_RECONNECT_GRACE_MS=15000

# optional, licensed Krisp bits live in priv/static/krisp (see its README)
PLAINWIRE_KRISP_ENABLED=false

# Public instance identity and sign-up policy
PLAINWIRE_REGISTRATION_ENABLED=true
PLAINWIRE_INSTANCE_DESCRIPTION="A fast, self-hosted place to talk."
# Repository shown by the first-run tour and Help surfaces. HTTPS only.
PLAINWIRE_SOURCE_REPOSITORY=https://github.com/Plainwire-development/Plainwire
# Plainwire Source uses the public GitHub REST API through the server. A token is
# optional, but recommended on busy public instances because it raises GitHub's
# upstream rate limit. Prefer a token with no repository permissions; Plainwire
# still filters responses to public-safe metadata. It is never returned to the browser.
PLAINWIRE_GITHUB_TOKEN=
# Cache public GitHub metadata for two minutes with a token (ten minutes without).
# Override only when you have a reason; values are clamped to 30s..1h.
PLAINWIRE_GITHUB_CACHE_TTL_MS=

# Cloudflare TURN takes priority when BOTH values are set. Keep tokens private.
# A Cloudflare Tunnel token is a different credential and will not work here.
PLAINWIRE_CF_TURN_KEY_ID=
PLAINWIRE_CF_TURN_API_TOKEN=
# Optional monthly usage guard. When account ID is present, unknown/stale usage
# prevents new credentials. Analytics is delayed; this is NOT a billing cap.
PLAINWIRE_CF_ACCOUNT_ID=
PLAINWIRE_CF_ANALYTICS_API_TOKEN=
PLAINWIRE_TURN_MONTHLY_LIMIT_BYTES=950000000000
PLAINWIRE_CF_USAGE_CHECK_INTERVAL_MS=300000

# Optional numeric diagnostics. Build with scripts/build-media-quality.sh.
# auto uses the worker if installed; off disables server analysis.
PLAINWIRE_MEDIA_QUALITY=auto
PLAINWIRE_ADAPTIVE_SCREEN=false

# Optional KLIPY GIF search. The key stays on the server and is never sent to clients.
PLAINWIRE_KLIPY_API_KEY=
PLAINWIRE_KLIPY_CONTENT_FILTER=medium
PLAINWIRE_KLIPY_COUNTRY=US
PLAINWIRE_KLIPY_LOCALE=en_US

# Optional service-operator control plane. This is for the configured Plainwire
# HOST, not for moderators inside individual Plainwire servers. It has a separate
# listener and separate operator sessions. Source code contains no admin key.
PLAINWIRE_ADMIN_ENABLED=false
# Loopback is the safe default. Put an HTTPS reverse proxy in front for remote use.
PLAINWIRE_ADMIN_BIND=127.0.0.1
PLAINWIRE_ADMIN_PORT=8090
PLAINWIRE_ADMIN_ACCEPTORS=10
PLAINWIRE_ADMIN_MAX_CONNECTIONS=2000
PLAINWIRE_ADMIN_SESSION_HOURS=12
PLAINWIRE_ADMIN_ENROLLMENT_MINUTES=60
# Production defaults to /var/lib/plainwire/admin-instance.key. Keep this file
# private and persistent; it binds operator verification keys to this instance.
PLAINWIRE_ADMIN_SECRET_FILE=/var/lib/plainwire/admin-instance.key
# Remote production access is deliberately opt-in and requires HTTPS + secure cookies.
PLAINWIRE_ADMIN_ALLOW_REMOTE=false
# Emergency only: generate one host-local owner recovery token on startup. Requires loopback bind. Remove after recovery.
PLAINWIRE_ADMIN_LOCAL_RECOVERY=false
PLAINWIRE_ADMIN_PUBLIC_URL=https://control.example.com
PLAINWIRE_ADMIN_COOKIE_SECURE=true

# Optional Redis real-time accelerator. Redis is never a durable authority.
# When Redis is disabled or unreachable, Plainwire falls back to its existing local
# ETS presence/rate-limit behavior and continues serving messages normally.
PLAINWIRE_REDIS_ENABLED=false
# Stable and unique per running node when using Redis-backed presence across nodes.
PLAINWIRE_NODE_ID=
PLAINWIRE_REDIS_HOST=127.0.0.1
PLAINWIRE_REDIS_PORT=6379
# Optional Redis 6+ ACL user. If set, password is required and AUTH username password is used.
PLAINWIRE_REDIS_USERNAME=
PLAINWIRE_REDIS_PASSWORD=
PLAINWIRE_REDIS_DB=0
PLAINWIRE_REDIS_PREFIX=plainwire
PLAINWIRE_REDIS_TIMEOUT_MS=80
PLAINWIRE_REDIS_TLS=false
# Emergency/private-network compatibility only. Keep false on public networks.
PLAINWIRE_REDIS_TLS_INSECURE=false

# Optional ScyllaDB high-volume message/event storage. PostgreSQL remains the
# relational authority. Keep `postgres` for small/self-hosted installations.
# Use `dual` only while migrating; see docs/SCYLLA.md.
PLAINWIRE_MESSAGE_BACKEND=postgres
PLAINWIRE_SCYLLA_ENABLED=false
PLAINWIRE_SCYLLA_CONTACT_POINTS=127.0.0.1
PLAINWIRE_SCYLLA_PORT=9042
PLAINWIRE_SCYLLA_KEYSPACE=plainwire
PLAINWIRE_SCYLLA_USERNAME=
PLAINWIRE_SCYLLA_PASSWORD=
PLAINWIRE_SCYLLA_TLS=false
PLAINWIRE_SCYLLA_CA_FILE=
PLAINWIRE_SCYLLA_CERT_FILE=
PLAINWIRE_SCYLLA_KEY_FILE=
PLAINWIRE_SCYLLA_LOCAL_DC=datacenter1
PLAINWIRE_SCYLLA_CONSISTENCY=local_quorum
PLAINWIRE_SCYLLA_POOL_SIZE=2
PLAINWIRE_SCYLLA_IO_THREADS=2
PLAINWIRE_SCYLLA_DRIVER_QUEUE=32768
PLAINWIRE_SCYLLA_CONNECT_TIMEOUT_MS=5000
PLAINWIRE_SCYLLA_REQUEST_TIMEOUT_MS=5000
PLAINWIRE_SCYLLA_OPERATION_TIMEOUT_MS=8000
PLAINWIRE_SCYLLA_MAX_INFLIGHT=256
PLAINWIRE_SCYLLA_MAX_PARTITION_INFLIGHT=8
PLAINWIRE_SCYLLA_MAX_QUEUE=4096
PLAINWIRE_SCYLLA_MAX_PARTITION_QUEUE=128
PLAINWIRE_SCYLLA_BUCKET_POLICY=month
PLAINWIRE_SCYLLA_HISTORY_BUCKETS=36
PLAINWIRE_SCYLLA_EVENT_RETENTION_DAYS=365
PLAINWIRE_SCYLLA_DELIVERY_RETENTION_DAYS=90
PLAINWIRE_SCYLLA_RECONCILE_INTERVAL_MS=300000
PLAINWIRE_SCYLLA_RECONCILE_ROWS=500
# Crash-recovery journal for Scylla-authoritative writes. Intents older than
# this grace are reconciled against PostgreSQL before cleanup.
PLAINWIRE_SCYLLA_WRITE_INTENT_GRACE_MS=300000
PLAINWIRE_SCYLLA_WRITE_INTENT_RECONCILE_ROWS=500
PLAINWIRE_SCYLLA_WRITE_INTENT_BUCKETS=512
PLAINWIRE_SCYLLA_SHADOW_SAMPLE_ROWS=200
PLAINWIRE_SCYLLA_BACKFILL_BATCH=250
PLAINWIRE_SCYLLA_BACKFILL_CONCURRENCY=8
PLAINWIRE_SCYLLA_BACKFILL_MAX_ROWS=0
PLAINWIRE_STORAGE_OUTBOX_INTERVAL_MS=250
PLAINWIRE_STORAGE_OUTBOX_BATCH=25
PLAINWIRE_STORAGE_OUTBOX_CONCURRENCY=8
PLAINWIRE_STORAGE_OUTBOX_RETENTION_DAYS=7
PLAINWIRE_STORAGE_OUTBOX_FAILED_RETENTION_DAYS=30
# `auto` claims one of 64 short-lived PostgreSQL-backed generator slots.
PLAINWIRE_MESSAGE_NODE_ID=auto
PLAINWIRE_MESSAGE_ID_CLOCK_ROLLBACK_MS=2000
# Stable per instance is recommended; otherwise a boot nonce intentionally makes
# concurrent local instances distinct and they probe separate generator slots.
PLAINWIRE_INSTANCE_ID=

PLAINWIRE_WEBHOOK_TIMEOUT_MS=8000
PLAINWIRE_WEBHOOK_WORKER_TIMEOUT_MS=13000
PLAINWIRE_WEBHOOK_DELIVERED_RETENTION_DAYS=7
PLAINWIRE_WEBHOOK_FAILED_RETENTION_DAYS=30
