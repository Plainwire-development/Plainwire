# Local development only. Production configuration is in .env.example.
PLAINWIRE_ENV=development
PLAINWIRE_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
PLAINWIRE_TRUST_PROXY=false
PLAINWIRE_DB_HOST=localhost
PLAINWIRE_DB_PORT=5432
PLAINWIRE_DB_USER=plainwire
PLAINWIRE_DB_PASS=plainwire
PLAINWIRE_DB_NAME=plainwire
PLAINWIRE_DB_SSL=false
PLAINWIRE_DB_POOL_SIZE=4
PLAINWIRE_UPLOAD_DIR=data/uploads
PLAINWIRE_DEFAULT_THEME=system
PORT=8080

# Optional KLIPY GIF search. The key stays on the server and is never sent to clients.
PLAINWIRE_KLIPY_API_KEY=
PLAINWIRE_KLIPY_CONTENT_FILTER=medium
PLAINWIRE_KLIPY_COUNTRY=US
PLAINWIRE_KLIPY_LOCALE=en_US

# Repository shown by the first-run tour and Help surfaces. HTTPS only.
PLAINWIRE_SOURCE_REPOSITORY=https://github.com/Plainwire-development/Plainwire
